{
  "expo": {
    "name": "Sassy 8-Ball",
    "slug": "sassy-eightball",
    "version": "1.0.0",
    "newArchEnabled": true,
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0b10"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "newArchEnabled": true
          }
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sassy.eightball",
      "infoPlist": {
        "UIBackgroundModes": [],
        "NSMotionUsageDescription": "We use the accelerometer to detect when you shake the 8-ball to reveal your sassy fortune.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0b10"
      },
      "package": "com.sassy.eightball",
      "permissions": [
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "scheme": "sassy8ball",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0caee6d8-9a9e-44d7-bfce-78d97e81f02e"
      }
    }
  }
}