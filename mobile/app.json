{
  "expo": {
    "name": "Sassy 8-Ball",
    "slug": "sassy-eightball",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0b10"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sassy.eightball",
      "infoPlist": {
        "UIBackgroundModes": [],
        "NSMotionUsageDescription": "We use the accelerometer to detect when you shake the 8-ball to reveal your sassy fortune."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0b10"
      },
      "package": "com.sassy.eightball",
      "permissions": ["VIBRATE"]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ],
    "scheme": "sassy8ball"
  }
}
